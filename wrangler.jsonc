{
  // Shield Battery: worker + static site + D1 database.
  "name": "shield-battery",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    // database_id is filled in after: npx wrangler d1 create shield-battery
    { "binding": "DB", "database_name": "shield-battery", "database_id": "48d293ac-f150-446e-9795-44f0a5d90d60" }
  ],
  "vars": { "SITE_PASSWORD": "Dunnage" },
  "routes": [ { "pattern": "foot.templararchives.org", "custom_domain": true } ]
}
